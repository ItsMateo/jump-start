{
	"name": "jump-start",
	"version": "1.0.0",
	"description": "A simple Discord bot that 'jump starts' Docker Compose containers via a voting system",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "bun run --watch src/index.ts",
		"lint": "biome check .",
    	"lint:fix": "biome check --write .",
    	"format": "biome format --write ."
	},
	"dependencies": {
		"discord.js": "^14.14.1",
		"dotenv": "^16.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.3",
		"@types/node": "^20.11.5",
		"typescript": "^5.3.3"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
